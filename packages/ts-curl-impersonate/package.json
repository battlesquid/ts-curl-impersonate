{
    "name": "ts-curl-impersonate",
    "description": "A typescript wrapper around cURL-impersonate.",
    "version": "1.0.10-rc.0",
    "author": "battlesquid",
    "license": "MIT",
    "main": "dist/index.js",
    "repository": {
        "url": "https://github.com/battlesquid/ts-curl-impersonate",
        "directory": "packages/ts-curl-impersonate"
    },
    "scripts": {
        "build": "tsc",
        "build:clean": "pnpm clean && pnpm build",
        "clean": "rm -rf dist",
        "clean:all": "pnpm clean && rm -rf node_modules",
  		"lint": "oxlint src",
		"lint:fix": "oxlint --fix src",
		"fmt": "oxfmt --check src",
		"fmt:fix": "oxfmt src",
        "test": "vitest --run",
        "test:clean": "pnpm clean:build && pnpm test"
    },
    "devDependencies": {
        "@types/node": "^20.5.9",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "vitest": "^4.0.14"
    },
    "optionalDependencies": {
        "ts-curl-impersonate-bin-darwin-x64": "1.0.1",
        "ts-curl-impersonate-bin-linux-arm64": "1.0.1",
        "ts-curl-impersonate-bin-linux-x64": "1.0.1",
        "ts-curl-impersonate-bin-win32-x64": "1.0.1"
    },
    "keywords": [
        "web-scraping",
        "tls-fingerprinting",
        "curl-impersonate",
        "typescript"
    ],
    "files": [
        "dist"
    ],
    "volta": {
        "extends": "../../package.json"
    }
}
